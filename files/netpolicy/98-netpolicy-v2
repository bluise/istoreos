#!/bin/sh
# ============================================================================
# 默认网络策略（首次开机执行一次；uci-defaults 排在系统自己的 config_generate 之后）
#   · LAN 固定为静态 10.0.0.1/24，DHCP 池 10.0.0.100-249
#   · 双网口：第一个网口(eth0) = WAN(自动获取)，第二个网口(eth1) = LAN
#   · 单网口：该网口 = LAN（不配置 WAN）；并给 LAN 配公共 DNS，避免首页报 DNS 错误
#   · 顺手清理“设备不存在”的悬挂接口（例如旧配置残留的 wan6 device='@wan'）
#
# 设计要点：**只做一次**。配置已符合策略就直接退出，不做任何 uci commit，
# 以免反复触发 LuCI 的“配置应用/回滚”流程（实测会出现应用循环）。
# ============================================================================
LAN_IP='10.0.0.1'
LAN_MASK='255.255.255.0'

log() { logger -t netpolicy "$*" 2>/dev/null; echo "netpolicy: $*"; }

nics() {
	for d in /sys/class/net/*; do
		n=${d##*/}
		[ -e "$d/device" ] || continue
		case "$n" in
			lo|br-*|veth*|docker*|@*) continue ;;
			eth*|en*) echo "$n" ;;
		esac
	done | sort
}

[ -f /etc/config/network ] || exit 0

LIST=$(nics)
N=$(echo "$LIST" | grep -c .)
FIRST=$(echo "$LIST" | sed -n 1p)
SECOND=$(echo "$LIST" | sed -n 2p)

if [ "$N" -ge 2 ]; then
	LAN_NIC="$SECOND"
	WAN_NIC="$FIRST"
else
	LAN_NIC="$FIRST"
	WAN_NIC=""
fi
[ -n "$LAN_NIC" ] || { log "没找到物理网口，保持原样"; exit 0; }

# ---- 幂等保护：已符合策略就什么都不做 ----
CUR_IP=$(uci -q get network.lan.ipaddr)
CUR_PORTS=$(uci -q get network.@device[0].ports)
if [ "$CUR_IP" = "$LAN_IP" ] && echo "$CUR_PORTS" | grep -qw "$LAN_NIC"; then
	if [ -z "$WAN_NIC" ]; then
		[ -z "$(uci -q get network.wan)" ] && { log "网络已符合策略($LAN_NIC=LAN)，跳过"; exit 0; }
	else
		[ "$(uci -q get network.wan.device)" = "$WAN_NIC" ] && { log "网络已符合策略($WAN_NIC=WAN,$LAN_NIC=LAN)，跳过"; exit 0; }
	fi
fi

log "检测到 $N 个网口: $(echo $LIST | tr '\n' ' ') -> LAN=$LAN_NIC WAN=${WAN_NIC:-无}"

# ---- 只重建 lan/wan/wan6 与名为 br-lan 的桥 ----
# 注意：**绝对不要碰其它接口**（尤其 wwan —— 无线中继用的就是它）。
# 早先版本把匿名段/其它设备段一起删了，结果和 WiFi 中继互相来回改配置，
# 触发了 LuCI 的“配置应用/回滚”死循环。
uci -q delete network.lan
uci -q delete network.wan
uci -q delete network.wan6
i=0
while uci -q get network.@device[$i] >/dev/null; do
	if [ "$(uci -q get network.@device[$i].name)" = "br-lan" ]; then
		uci -q delete network.@device[$i]
		continue
	fi
	i=$((i + 1))
done

uci set network.loopback=interface
uci set network.loopback.device='lo'
uci set network.loopback.proto='static'
uci set network.loopback.ipaddr='127.0.0.1'
uci set network.loopback.netmask='255.0.0.0'

uci add network device >/dev/null
uci set network.@device[-1].name='br-lan'
uci set network.@device[-1].type='bridge'
uci add_list network.@device[-1].ports="$LAN_NIC"

uci set network.lan=interface
uci set network.lan.device='br-lan'
uci set network.lan.proto='static'
uci set network.lan.ipaddr="$LAN_IP"
uci set network.lan.netmask="$LAN_MASK"
uci set network.lan.ip6assign='60'
if [ -z "$WAN_NIC" ]; then
	uci add_list network.lan.dns='223.5.5.5'
	uci add_list network.lan.dns='119.29.29.29'
else
	uci set network.wan=interface
	uci set network.wan.device="$WAN_NIC"
	uci set network.wan.proto='dhcp'
	uci set network.wan6=interface
	uci set network.wan6.device='@wan'
	uci set network.wan6.proto='dhcpv6'
fi
# 一次性提交 network
uci commit network

# ---- DHCP 地址池（一次性提交）----
if [ -e /etc/config/dhcp ]; then
	uci set dhcp.lan=dhcp
	uci set dhcp.lan.interface='lan'
	uci set dhcp.lan.start='100'
	uci set dhcp.lan.limit='150'
	uci set dhcp.lan.leasetime='12h'
	uci set dhcp.lan.ignore='0'
	uci commit dhcp
fi

# ---- 清理“设备不存在”的悬挂接口（只删不改，最后统一提交一次）----
iface_exists() { uci -q get "network.$1" >/dev/null 2>&1; }
dev_exists() {
	[ -e "/sys/class/net/$1" ] && return 0
	i=0
	while uci -q get network.@device[$i] >/dev/null; do
		[ "$(uci -q get network.@device[$i].name)" = "$1" ] && return 0
		i=$((i + 1))
	done
	return 1
}
dropped=""
i=0
while uci -q get network.@interface[$i] >/dev/null; do
	dev=$(uci -q get network.@interface[$i].device)
	sec=$(uci -q get network.@interface[$i] 2>/dev/null)
	keep=1
	if [ -n "$dev" ]; then
		case "$dev" in
			@*) iface_exists "${dev#@}" || keep=0 ;;
			*)  dev_exists "$dev" || keep=0 ;;
		esac
	fi
	if [ "$keep" = 0 ]; then
		dropped="$dropped $sec"
		uci -q delete network.@interface[$i]
		continue
	fi
	i=$((i + 1))
done
for sec in $(uci -q show network | sed -n 's/^\(network\.[A-Za-z0-9_]*\)=interface$/\1/p'); do
	case "$sec" in network.loopback) continue ;; esac
	dev=$(uci -q get "$sec.device")
	[ -n "$dev" ] || continue
	keep=1
	case "$dev" in
		@*) iface_exists "${dev#@}" || keep=0 ;;
		*)  dev_exists "$dev" || keep=0 ;;
	esac
	if [ "$keep" = 0 ]; then
		dropped="$dropped $sec"
		uci -q delete "$sec"
	fi
done
if [ -n "$dropped" ]; then
	log "已删除设备不存在的接口:$dropped"
	uci commit network
fi

# ---- 让配置立即生效（只做这一次）----
/etc/init.d/network reload >/dev/null 2>&1
sleep 2
log "已应用: LAN=$LAN_IP (br-lan -> $LAN_NIC)${WAN_NIC:+, WAN=$WAN_NIC(dhcp)}"
exit 0
